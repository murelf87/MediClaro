+              backgroundColor: c.textMuted,
+              opacity: t.interpolate({
+                inputRange: [0, 0.33, 0.66, 1],
+                outputRange: i === 0 ? [1, 0.3, 0.3, 1] : i === 1 ? [0.3, 1, 0.3, 0.3] : [0.3, 0.3, 1, 0.3],
