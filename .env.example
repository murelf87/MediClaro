# Secretos del SERVIDOR (se guardan con `supabase secrets set`, NUNCA en la app)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASE=price_...
STRIPE_PRICE_METERED=price_...
STRIPE_METER_EVENT=mediclaro_escaneo_extra
STRIPE_AUTOMATIC_TAX=false
# «Que pague mi familiar o cuidador/a» (función family-pay, 09/10/2026) — opcionales:
# precios de Stripe de los planes trimestral y anual (si no, solo se ofrece el mensual) y enlaces propios.
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_ANNUAL=
FAMILY_PAY_PUBLIC_URL=
FAMILY_PAY_DONE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# APP (iPhone y Android) — valores PÚBLICOS. Copie este bloque a `.env` o
# póngalo como variables de entorno de EAS. Nunca ponga aquí secretos.
# (Alternativa para Supabase: app.json > extra > supabaseUrl / supabaseAnonKey)
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Caducidad del código SMS en segundos (igual que en Supabase Auth → Phone)
EXPO_PUBLIC_OTP_TTL_SECONDS=300
# Correo de soporte que aparece en Ayuda (vacío = se oculta el botón)
EXPO_PUBLIC_SUPPORT_EMAIL=
# Teléfono de ayuda con el pago (vacío = no se muestra). Solo un número real atendido.
EXPO_PUBLIC_SUPPORT_PHONE=
# Sello de confianza al que el titular esté ADHERIDO de verdad (p. ej. Confianza Online): nombre y página pública
# de verificación. Vacío = no se muestra ningún sello externo.
EXPO_PUBLIC_TRUST_SEAL_NAME=
EXPO_PUBLIC_TRUST_SEAL_URL=
# App Store Connect: ID numérico de la ficha pública (para valorar/compartir en iPhone)
EXPO_PUBLIC_APP_STORE_ID=
# Landing pública opcional que redirija a App Store / Google Play según dispositivo
EXPO_PUBLIC_APP_SHARE_URL=
# Documentos legales publicados (vacío = «Pendiente de publicación»)
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_LEGAL_NOTICE_URL=
# Titular (aviso legal, LSSI)
EXPO_PUBLIC_COMPANY_NAME=
EXPO_PUBLIC_COMPANY_TAX_ID=
EXPO_PUBLIC_COMPANY_ADDRESS=
# Botón temporal «Entrar sin verificar»: on / off. Vacío = «on» solo en desarrollo (`npx expo start`) y «off» en
# compilaciones de publicación. eas.json ya lo fija: on en development y preview, off en production.
EXPO_PUBLIC_DEMO_ACCESS=
# Cobro dentro de la app (v1.2), lista separada por comas: store (compra integrada de Apple/Google Play) /
# stripe (tarjeta en la página segura de Stripe) / store,stripe / none (sin compras ni precios).
# Vacío = «store,stripe» en desarrollo y «store» en publicación. eas.json ya lo fija: store,stripe en development y preview, store en production.
EXPO_PUBLIC_PAYMENTS_MODE=
