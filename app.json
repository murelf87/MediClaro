{
  "expo": {
    "name": "MediClaro",
    "slug": "mediclaro",
    "scheme": "mediclaro",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.mediclaro.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": [
          "es"
        ],
        "LSApplicationQueriesSchemes": [
          "tel",
          "telprompt",
          "sms",
          "mailto",
          "maps",
          "comgooglemaps",
          "whatsapp"
        ],
        "NSMicrophoneUsageDescription": "MediClaro usa el micrófono cuando mantienes pulsado para hablar con el asistente MediClaro y durante las llamadas de voz con tu cuidador/a.",
        "NSMotionUsageDescription": "MediClaro puede acceder a los sensores de movimiento del dispositivo cuando una función de seguridad o asistencia lo requiera, siempre con tu permiso.",
        "NSFaceIDUsageDescription": "MediClaro usa Face ID solo para abrir el panel privado del propietario de la app."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.mediclaro.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "MediClaro usa Face ID solo para abrir el panel privado del propietario de la app."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MediClaro usa la cámara para fotografiar la caja de tu medicamento e identificarlo.",
          "microphonePermission": "MediClaro usa el micrófono cuando mantienes pulsado para hablar con la asistente o cuando aceptas una llamada de audio con tu cuidador.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Durante un aviso activo, MediClaro comparte tu ubicación con tu cuidador vinculado si lo autorizas. Se muestra la hora de la última actualización.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "MediClaro puede acceder a los sensores de movimiento del dispositivo cuando una función de seguridad o asistencia lo requiera, siempre con tu permiso.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MediClaro usa tus fotos solo si eliges una imagen de la caja de tu medicamento para identificarla.",
          "cameraPermission": "MediClaro usa la cámara para fotografiar la caja de tu medicamento e identificarlo.",
          "microphonePermission": "MediClaro usa el micrófono cuando mantienes pulsado para hablar con la asistente o cuando aceptas una llamada de audio con tu cuidador."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "MediClaro usa el micrófono cuando mantienes pulsado para hablar con la asistente o cuando aceptas una llamada de audio con tu cuidador.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-iap",
      "./plugins/withAndroidQueries",
      [
        "expo-notifications",
        {
          "defaultChannel": "caregiver-alerts",
          "sounds": [
            "./assets/sounds/mediclaro_alarma.wav"
          ]
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-asset",
      "./plugins/withRequiredIosPrivacy"
    ],
    "extra": {
      "supabaseUrl": "https://TU-PROYECTO.supabase.co",
      "supabaseAnonKey": "TU_ANON_KEY",
      "router": {},
      "eas": {
        "projectId": "fefacac9-9dc6-42fe-972e-15b3b62f4286"
      },
      "buildLabel": "1.0.1-qa-32-20261008",
      "appReviewReady": false
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#FFFFFF",
    "platforms": [
      "ios",
      "android"
    ],
    "owner": "antoniom87"
  }
}
