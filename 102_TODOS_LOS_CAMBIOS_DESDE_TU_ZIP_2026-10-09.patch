+                <HistoryRow key={it.key} entry={it} onPress={() => setDetail(it)} />
+              ))}
+            </View>
+          ))
+        )}
+
+        <SecondaryButton
+          label={Platform.OS === 'web' ? 'Descargar mi historial' : 'Compartir mi historial'}
+          icon={Platform.OS === 'web' ? 'download-outline' : 'share-outline'}
