+            />
+          </FadeIn>
+          <FadeIn delay={stagger(2, 90, 80)}>
+            <MethodCard
+              icon="share-social"
+              iconColor="#FFFFFF"
+              iconBg="#7C3AED"
+              title="Compartir enlace"
