+  return (
+    <Text
+      allowFontScaling={false}
+      numberOfLines={lines}
+      style={[{ fontSize: size, lineHeight: Math.round(size * 1.3), fontWeight: weight, color: color ?? c.heading, textAlign: align }, style]}
+    >
+      {children}
+    </Text>
+  );
