+    title: '7 · Pregunta a MediClaro',
+    text: '«¿Qué pastillas me quedan hoy?», «¿Me he tomado la de la tensión?». El asistente responde con tus tomas confirmadas de verdad, nunca inventa.',
+  },
+];
+
+function PillsHelpScreen() {
