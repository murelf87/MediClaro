+assert.equal(await call(C4, 'incoming'), null);
+assert.equal((await db.query(`select state from public.care_link_calls where id = $1`, [CALL6])).rows[0].state, 'ended');
+
+// ─── Portabilidad («Descargar mis datos») ────────────────────────────────────────────────────────────────
+r = await chat(P, 'export');
