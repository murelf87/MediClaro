+
+  // Con la voz, el paso lo marca la grabación; si no, el que se haya elegido a mano.
+  const index = listening && !show.finished ? careStepAt(show.position) : manual;
+  const step = CARE_STEPS[Math.min(index, CARE_STEPS.length - 1)];
+  useEffect(() => {
